# Copy this file to .env and replace the development secret before deploying.
TALKROOM_SECRET_KEY=replace-with-a-long-random-secret
TALKROOM_DATABASE_URL=sqlite:///./talkroom.db

# HarakaPay Collection API (USSD-PUSH). Keep this key server-side only.
HARAKAPAY_API_KEY=hpk_da901c14bd80f4477ed9e720e15d100e3d28da976651f989
# Optional callback URL. The app validates every callback through HarakaPay's status API.
HARAKAPAY_WEBHOOK_URL=https://stucco-sternum-dreamy.ngrok-free.dev/api/payments/harakapay/webhook

# ClickPesa Payout API (teacher withdrawals only).
CLICKPESA_CLIENT_ID=your-clickpesa-client-id
CLICKPESA_API_KEY=your-clickpesa-api-key
# Optional: only set when checksum signing is enabled in ClickPesa.
CLICKPESA_CHECKSUM_KEY=
# Public HTTPS endpoint configured for ClickPesa payout webhooks.
CLICKPESA_WEBHOOK_URL=https://stucco-sternum-dreamy.ngrok-free.dev/api/payments/clickpesa/webhook
